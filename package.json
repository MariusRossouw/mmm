{
	"name": "mmm",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && VITE_CONFIG_URL=$npm_config_url VITE_API_KEY=$npm_config_api_key vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.48.5",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"publint": "^0.3.15",
		"svelte": "^5.43.8",
		"svelte-eslint-parser": "^1.4.0",
		"vite": "^7.2.2"
	},
	"dependencies": {
		"@julr/vite-plugin-validate-env": "^2.2.0",
		"@stratech-team/svelte5-component-library": "^0.0.152",
		"@sveltejs/adapter-static": "^3.0.10",
		"crypto-js": "^4.2.0"
	},
	"lint-staged": {
		"*.{js,svelte}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,css,md}": [
			"prettier --write"
		]
	}
}
